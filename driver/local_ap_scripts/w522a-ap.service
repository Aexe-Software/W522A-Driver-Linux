[Unit]
Description=W522A local access point
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/w522a-ap
ExecStart=/usr/local/sbin/w522a-ap-up.sh up
ExecStop=/usr/local/sbin/w522a-ap-up.sh down
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
